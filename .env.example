# Copy to .env and fill in real values. Never commit .env.

# Account API (the Express app in ./backend). Proxied through this app by
# next.config, so the browser only ever talks to this site's own origin.
# Local: http://localhost:5000 · Deployed: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Catalogue search proxy used for the app's own music results.
MUSIC_API=https://saavn.sumit.co/api

# Spotify Developer App credentials (dashboard.spotify.com).
# Only the client id is read by the app. The PKCE flow needs no secret;
# do not put the secret in any code path or bundle.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=keep_out_of_the_app_unused_by_pkce_flow

# Optional. Exact OAuth redirect URI. Defaults to the dev-server value:
#   http://localhost:3000/api/spotify/callback
# Set this when hosting the app on another origin, and add the same URI
# in the Spotify dashboard. Must end with /api/spotify/callback.
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
